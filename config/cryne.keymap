#define ZMK_POINTING_DEFAULT_MOVE_VAL 1100  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // default: 10

#define TAPPING_TERM_TAP_DANCE 200
#define TAPPING_TERM_HRM 310
#define TAPPING_TERM_MOD_TAP 260
#define REQUIRE_PRIOR_IDLE_MS 150
#define QUICK_TAP_MS 175
#define COMBO_TIMEOUT_MS 50

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

// #define MO_TOG(layer) &mo_tog layer layer;
// #define TD_C(key, mod) &td_c <&mt mod key>, <&sk mod>;

/ {
    behaviors {
        bspc_del: backspace_delete {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BACKSPACE>, <&kp DELETE>;

            mods = <(MOD_LSFT|MOD_RSFT)>;

            // Keeps mod dosn't remove the mod after the morph
            // keep-mods = <(MOD_RSFT)>;
        };

        //Mouse
        mouse_h: mouse_left_scroll {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&mmv MOVE_LEFT>, <&msc SCRL_LEFT>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        mouse_j: mouse_down_scroll {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&mmv MOVE_DOWN>, <&msc SCRL_DOWN>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        mouse_k: mouse_up_scroll {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&mmv MOVE_UP>, <&msc SCRL_UP>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        mouse_l: mouse_right_scroll {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&mmv MOVE_RIGHT>, <&msc SCRL_RIGHT>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        //Layers
        td_layer1: tap_dance_layer1 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <TAPPING_TERM_TAP_DANCE>;
            bindings = <&mo 1>, <&to 1>;
        };
        td_layer2: tap_dance_layer2 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <TAPPING_TERM_TAP_DANCE>;
            bindings = <&mo 2>, <&to 2>;
        };
        td_layer3: tap_dance_layer3 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <TAPPING_TERM_TAP_DANCE>;
            bindings = <&mo 2>, <&to 3>;
        };

        // Home Row Mods
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <REQUIRE_PRIOR_IDLE_MS>;
            tapping-term-ms = <TAPPING_TERM_HRM>;
            quick-tap-ms = <QUICK_TAP_MS>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 32 33>; // Right side keys + right thumb keys
            hold-trigger-on-release;
        };
        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <REQUIRE_PRIOR_IDLE_MS>;
            tapping-term-ms = <TAPPING_TERM_HRM>;
            quick-tap-ms = <QUICK_TAP_MS>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31>; // Left side keys + left thumb keys
            hold-trigger-on-release;
        };

        // Thumb hold-taps
        spc_lwr: space_lower {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            require-prior-idle-ms = <REQUIRE_PRIOR_IDLE_MS>;
            tapping-term-ms = <TAPPING_TERM_TAP_DANCE>;
            bindings = <&mo>, <&kp>;
        };

        ret_esc: ret_esc {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <TAPPING_TERM_TAP_DANCE>;
            bindings = <&kp>, <&kp>;
        };

        tab_raise: tab_raise {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <TAPPING_TERM_TAP_DANCE>;
            bindings = <&mo>, <&kp>;
        };

        // Toggle layer
        mo_tog: behavior_mo_tog {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <TAPPING_TERM_TAP_DANCE>;
            bindings = <&mo>, <&tog>;
        };

        mt: mod_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <TAPPING_TERM_MOD_TAP>;
            bindings = <&kp>, <&kp>;

            display-name = "Mod-Tap";
        };

        td_c: tap_dance_c {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <TAPPING_TERM_TAP_DANCE>;
            bindings = <&kt>, <&sk>;
        };

        spc_under: space_underscore {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp SPACE>, <&kp UNDERSCORE>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // Navigation mod-morphs (lower layer): arrow / shift=extended nav
        left_home: left_home {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LEFT>, <&kp HOME>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        down_pgdn: down_page_down {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DOWN>, <&kp PAGE_DOWN>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        up_pgup: up_page_up {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp UP>, <&kp PAGE_UP>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        right_end: right_end {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp RIGHT>, <&kp END>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // Home row combos (Vim style arrows): H-J-K-L
        combo_left {
            timeout-ms = <COMBO_TIMEOUT_MS>;
            key-positions = <15 16>; // H + J
            bindings = <&kp LEFT>;
            require-prior-idle-ms = <REQUIRE_PRIOR_IDLE_MS>;
            layers = <0>;
        };
        combo_up {
            timeout-ms = <COMBO_TIMEOUT_MS>;
            key-positions = <16 17>; // J + K
            bindings = <&kp UP>;
            require-prior-idle-ms = <REQUIRE_PRIOR_IDLE_MS>;
            layers = <0>;
        };
        combo_down {
            timeout-ms = <COMBO_TIMEOUT_MS>;
            key-positions = <17 18>; // K + L
            bindings = <&kp DOWN>;
            require-prior-idle-ms = <REQUIRE_PRIOR_IDLE_MS>;
            layers = <0>;
        };
        combo_right {
            timeout-ms = <COMBO_TIMEOUT_MS>;
            key-positions = <18 19>; // L + ;
            bindings = <&kp RIGHT>;
            require-prior-idle-ms = <REQUIRE_PRIOR_IDLE_MS>;
            layers = <0>;
        };

        // Bottom row combos (navigation): N-M-,-.
        combo_home {
            timeout-ms = <COMBO_TIMEOUT_MS>;
            key-positions = <25 26>; // N + M
            bindings = <&kp HOME>;
            require-prior-idle-ms = <REQUIRE_PRIOR_IDLE_MS>;
            layers = <0>;
        };
        combo_pgup {
            timeout-ms = <COMBO_TIMEOUT_MS>;
            key-positions = <26 27>; // M + ,
            bindings = <&kp PG_UP>;
            require-prior-idle-ms = <REQUIRE_PRIOR_IDLE_MS>;
            layers = <0>;
        };
        combo_pgdw {
            timeout-ms = <COMBO_TIMEOUT_MS>;
            key-positions = <27 28>; // , + .
            bindings = <&kp PAGE_DOWN>;
            require-prior-idle-ms = <REQUIRE_PRIOR_IDLE_MS>;
            layers = <0>;
        };
        combo_end {
            timeout-ms = <COMBO_TIMEOUT_MS>;
            key-positions = <28 29>; // . + /
            bindings = <&kp END>;
            require-prior-idle-ms = <REQUIRE_PRIOR_IDLE_MS>;
            layers = <0>;
        };

        // Top row combos for common keys
        combo_backspace {
            timeout-ms = <COMBO_TIMEOUT_MS>;
            key-positions = <6 7>; // U + I
            bindings = <&kp BACKSPACE>;
            require-prior-idle-ms = <REQUIRE_PRIOR_IDLE_MS>;
            layers = <0>;
        };
        combo_delete {
            timeout-ms = <COMBO_TIMEOUT_MS>;
            key-positions = <7 8>; // I + O
            bindings = <&kp DELETE>;
            require-prior-idle-ms = <REQUIRE_PRIOR_IDLE_MS>;
            layers = <0>;
        };
        combo_esc {
            timeout-ms = <COMBO_TIMEOUT_MS>;
            key-positions = <2 3>; // W + E
            bindings = <&kp ESCAPE>;
            require-prior-idle-ms = <REQUIRE_PRIOR_IDLE_MS>;
            layers = <0>;
        };
        combo_tab {
            timeout-ms = <COMBO_TIMEOUT_MS>;
            key-positions = <3 4>; // E + R
            bindings = <&kp TAB>;
            require-prior-idle-ms = <REQUIRE_PRIOR_IDLE_MS>;
            layers = <0>;
        };

        // Home row utility combos (left hand)
        combo_repeat {
            timeout-ms = <COMBO_TIMEOUT_MS>;
            key-positions = <12 13>; // D + F
            bindings = <&key_repeat>;
            require-prior-idle-ms = <REQUIRE_PRIOR_IDLE_MS>;
            layers = <0>;
        };
        combo_caps_word {
            timeout-ms = <COMBO_TIMEOUT_MS>;
            key-positions = <11 12>; // S + D
            bindings = <&caps_word>;
            require-prior-idle-ms = <REQUIRE_PRIOR_IDLE_MS>;
            layers = <0>;
        };
        combo_undo {
            timeout-ms = <COMBO_TIMEOUT_MS>;
            key-positions = <21 22>; // X + C
            bindings = <&kp LC(Z)>;
            require-prior-idle-ms = <REQUIRE_PRIOR_IDLE_MS>;
            layers = <0>;
        };
        combo_mouse_layer {
            timeout-ms = <COMBO_TIMEOUT_MS>;
            key-positions = <13 14>; // F + G
            bindings = <&tog 3>;
            require-prior-idle-ms = <REQUIRE_PRIOR_IDLE_MS>;
            layers = <0 3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default Layer";

            // ----------------------------------------------------------------
            // |  Q  |  W  |  E  |  R  |  T  | |  Y  |  U  |  I  |  O  |  P  |
            // |  A  | S/⇧ | D/⎈ | F/⊞ | G/⎇ | | H/⎇ | J/⊞ | K/⎈ | L/⇧ |  ;  |
            // |  Z  |  X  |  C  |  V  |  B  | |  N  |  M  |  ,  |  .  |  /  |
            //                   | TAB | SPC | | RET | BSPC|

            bindings = <
&kp Q &kp W         &kp E        &kp R       &kp T       /**/ &kp Y       &kp U       &kp I        &kp O         &kp P
&kp A &hml LSHIFT S &hml LCTRL D &hml LGUI F &hml LALT G /**/ &hmr RALT H &hmr RGUI J &hmr RCTRL K &hmr RSHIFT L &kp SEMI
&kp Z &kp X         &kp C        &kp V       &kp B       /**/ &kp N       &kp M       &kp COMMA    &kp DOT       &kp FSLH
                                 &spc_lwr 1 TAB &tab_raise 2 SPACE /**/ &ret_esc ESC RET &bspc_del
            >;
        };

        lower_layer {
            display-name = "Lower Layer";
            // -----------------------------------------------------------------
            // |  1  |  2  |  3  |  4  |  5  | |  6  |  7  |  8  |  9  |  0  |
            // |     |     |     |     |     | |  -  |  =  |  '  |  [  |  ]  |
            // |     |     |     |     |     | |     |     |     |     |  \  |
            //                   |     |     | | TO0 |     |
            bindings = <
&kp N1  &kp N2 &kp N3 &kp N4 &kp N5 /**/ &kp N6     &kp N7     &kp N8   &kp N9     &kp N0
&trans  &trans &trans &trans &trans /**/ &kp MINUS &kp EQUAL &kp APOS  &kp LBKT &kp RBKT
&trans  &trans &trans &trans &trans /**/ &trans    &trans    &trans    &trans   &kp BSLH
                      &trans &trans /**/ &to 0     &trans
            >;
        };

        mouse_layer {
            display-name = "Mouse Layer";

            // ---------------------------------------------------------------
            // | BT1 | BT2 | BT3 | BT4 | BT5 | | BTN | PRV | CLR | OUT | BOOT|
            // | BDN | BUP | VDN | VUP | MUT | | MS← | MS↓ | MS↑ | MS→ | SOFF|
            // |     |     | PRV | PLY | NXT | | MB1 | MB2 | MB3 |     | STUD|
            //                   |     |     | | TO0 |     |

            bindings = <
&bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 /**/ &bt BT_NXT &kp C_PREV &bt BT_CLR &out OUT_TOG &bootloader
&kp C_BRI_DN &kp C_BRI_UP &kp C_VOL_DN &kp C_VOL_UP &kp C_MUTE   /**/ &mouse_h   &mouse_j   &mouse_k   &mouse_l     &soft_off
&trans       &trans       &kp C_PREV   &kp C_PP     &kp C_NEXT   /**/ &mkp MB1   &mkp MB2   &mkp MB3   &trans       &studio_unlock
                                       &trans       &trans       /**/ &to 0      &trans
            >;
        };
    };
};
